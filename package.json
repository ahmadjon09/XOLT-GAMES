{
  "name": "xolt-games",
  "private": true,
  "version": "1.0.0",
  "description": "XOLT Games — multiplayer games and public player profiles",
  "type": "module",
  "scripts": {
    "build": "npm --prefix client run build",
    "test": "node --test \"tests/*.test.js\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "preview": "node preview/ensure-dist.mjs && node --import ./preview/register-loader.mjs preview/server.mjs"
  },
  "devDependencies": {
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  }
}
