# PostgreSQL ulanish
DATABASE_URL="postgresql://xolt:xolt_password@127.0.0.1:5432/xolt_games"

# JWT kalit (buni albatta almashtiring)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# Server port
PORT=4000

# Frontend URL (QR kod va CORS uchun)
FRONTEND_URL="https://xolt.uz"
CORS_ORIGINS="https://xolt.uz,https://www.xolt.uz"

# Fayllar uchun papka
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5

# imgbb.com API kaliti (https://api.imgbb.com dan bepul olinadi)
# O'rnatilgan bo'lsa barcha rasmlar imgbb.com ga yuklanadi, aks holda lokal saqlanadi
IMGBB_API_KEY=""

# Redis (cache) - o'rnatilgan bo'lsa DB yukini kamaytiradi
REDIS_URL="redis://127.0.0.1:6379"

# ============ RACE 3D (server-avtoritar poyga) ============
# Fizika tick chastotasi (Hz). Client bilan BIR XIL bo'lishi shart.
RACE_TICK_RATE=30
# Snapshot chastotasi (Hz) — tick'dan mustaqil (kamroq = kamroq trafik)
RACE_SNAPSHOT_RATE=20
# Xonadagi maksimal o'yinchilar (1..32, tavsiya 16)
RACE_MAX_PLAYERS=16
# Bir paketda nechta input qayta yuboriladi (packet loss himoyasi)
RACE_INPUT_REDUNDANCY=3
# Har necha tickda to'liq (keyframe) snapshot
RACE_KEYFRAME_INTERVAL=20
# Interest management radiusi (m) — faqat yaqin mashinalar yuboriladi
RACE_INTEREST_RADIUS=140
# Bo'sh xonani avtomatik yopish (ms)
RACE_IDLE_STOP_MS=30000
# Reconnect uchun berilgan vaqt (ms)
RACE_RECONNECT_GRACE_MS=25000
# Metrikalarni log qilish oralig'i (ms)
RACE_METRICS_INTERVAL_MS=15000
# Client input yuborish chastotasi chegarasi (Hz) — anti-flood
RACE_MAX_INPUT_RATE=90
# 60 s ichida ruxsat etilgan input soni (flood => kick)
RACE_INPUT_FLOOD_LIMIT=6000
# Xona sikli (ms) — barcha xonalar bitta timer bilan tick qilinadi
RACE_LOOP_MS=8
# Bir vaqtda ochilishi mumkin bo'lgan xonalar soni
RACE_MAX_ROOMS=200
# Bitta IP dan daqiqasiga nechta xona yaratish mumkin (anti-DoS)
RACE_CREATE_LIMIT_PER_MIN=10
# Poyga tugaganidan keyin xonani tozalash (ms)
RACE_FINISHED_CLEANUP_MS=60000

# ============ SERVER SIG'IMI (RAM/CPU QO'RIQCHISI) ============
# RAM to'lib qolganda process OOM bilan CRASH bo'lmasligi uchun yangi o'yinlar
# rad etiladi ("server band"). Ketayotgan o'yinlar to'xtatilmaydi.
#
# RAM chegarasi (MB). Bo'sh bo'lsa — cgroup (Docker/PaaS) yoki tizim RAM'i
# avtomatik aniqlanadi. VPS'da boshqa xizmatlar bo'lsa qo'lda kiriting.
SERVER_MEM_LIMIT_MB=
# Ogohlantirish darajasi (%): faqat ENG OG'IR o'yin (3D poyga) yopiladi
CAP_MEM_WARN_PCT=75
# Band darajasi (%): hech qanday yangi o'yin ochilmaydi
CAP_MEM_BUSY_PCT=88
# Event loop kechikishi (ms) — CPU bo'g'ilganini ko'rsatadi
CAP_LOOP_LAG_WARN_MS=150
CAP_LOOP_LAG_BUSY_MS=400
# Bir vaqtdagi maksimal socket va aktiv o'yin xonalari
CAP_MAX_SOCKETS=4000
CAP_MAX_ACTIVE_GAMES=500
# "Band" holatdan chiqish uchun tinch davr (ms) — holat sakramasligi uchun
CAP_RECOVER_MS=5000
# Bitta 3D poyga xonasining taxminiy xotira narxi (MB) — dinamik limit uchun
CAP_RACE3D_ROOM_MB=6
# Client'ga "shuncha ms dan keyin urinib ko'ring" deb aytiladi
CAP_RETRY_AFTER_MS=15000
# O'lchash oralig'i (ms)
CAP_SAMPLE_MS=1000

# 3D poyga: DB javob bermasa shuncha ms dan keyin JWT ma'lumoti bilan davom
# etiladi (client "TIMEOUT" ko'rmasligi uchun)
RACE_DB_TIMEOUT_MS=1500
