# PostgreSQL ulanish
DATABASE_URL="postgresql://xolt:xolt_password@127.0.0.1:5432/xolt_games"

# JWT kalit (buni albatta almashtiring)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# Server port
PORT=4000

# Frontend URL (QR kod va CORS uchun)
FRONTEND_URL="https://xolt.uz"
CORS_ORIGINS="https://xolt.uz,https://www.xolt.uz"

# Fayllar uchun papka
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5

# imgbb.com API kaliti (https://api.imgbb.com dan bepul olinadi)
# O'rnatilgan bo'lsa barcha rasmlar imgbb.com ga yuklanadi, aks holda lokal saqlanadi
IMGBB_API_KEY=""

# Redis (cache) - o'rnatilgan bo'lsa DB yukini kamaytiradi
REDIS_URL="redis://127.0.0.1:6379"
